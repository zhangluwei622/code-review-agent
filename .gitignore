# Publish only reproducible project content; keep local history and state private.
/*
!/.gitignore
!/README.md
!/pyproject.toml
!/uv.lock
!/src/
!/tests/
!/examples/
!/docs/

/examples/*
!/examples/diffs/
!/examples/provider/
!/examples/eval/
/examples/eval/*
!/examples/eval/phase-5/
/examples/eval/phase-5/*
!/examples/eval/phase-5/dataset.json
!/examples/eval/phase-5/dataset-v2.json
!/examples/eval/phase-5/diffs/
!/examples/eval/phase-5/fixtures/

/docs/*
!/docs/architecture/
!/docs/implementation/
/docs/architecture/*
!/docs/architecture/260914-code-review-agent-public-overview.md
/docs/implementation/*
!/docs/implementation/260914-code-review-agent-public-verification.md

.venv/
.venv-*/
.uv-cache/
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]
*.egg-info/
.DS_Store
.review-agent/
*.sqlite*
*.db
*.lock
!uv.lock
.env*
*.pem
*.key
